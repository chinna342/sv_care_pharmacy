{
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/auth/send-email-otp",
      "destination": "/api/send-email-otp"
    },
    {
      "source": "/api/auth/verify-email-otp",
      "destination": "/api/verify-email-otp"
    },
    {
      "source": "/auth/send-email-otp",
      "destination": "/api/send-email-otp"
    },
    {
      "source": "/auth/verify-email-otp",
      "destination": "/api/verify-email-otp"
    },
    {
      "source": "/api/orders/:path*",
      "destination": "/api/orders"
    },
    {
      "source": "/orders/:path*",
      "destination": "/api/orders"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
